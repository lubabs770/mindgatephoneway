# mindgatephoneway — optional overrides. Copy to .env and edit.
# Every var here mirrors a default in config.ts; leaving it unset uses the default.

# ── Browser ──
# MGP_PROFILE_DIR=./.gvoice-profile
# MGP_CHROME_CHANNEL=chrome
# MGP_HEADLESS=true
# MGP_TIMEOUT_MS=60000

# ── Google Voice ──
# MGP_GV_URL=https://voice.google.com/u/0/messages
# MGP_READY_SELECTOR=gv-thread-list, gv-annotation

# ── Capture ──
# MGP_CAPTURE_MODE=sniff        # sniff | dom
# MGP_RESYNC_MS=300000

# ── Sink ──
# MGP_SINK=jsonl                # jsonl (default) | sqlite (native build) | webhook
# MGP_SQLITE_PATH=./data/messages.db
# MGP_JSONL_PATH=./data/messages.jsonl
# MGP_WEBHOOK_URL=

# ── Health ──
# MGP_HEARTBEAT=./data/heartbeat
# MGP_REAUTH_ALERT_URL=

# ── Logging ──
# MGP_LOG_LEVEL=info            # debug | info | warn | error
